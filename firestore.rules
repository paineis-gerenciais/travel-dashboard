rules_version = '2';
// Regras de segurança da Fase 2 (o item crítico).
// Modelo multi-viagem com compartilhamento por convite endereçado a e-mail.
//
// Princípios:
//  - Cada viagem tem uma lista `memberUids`. Só quem está nela lê/escreve.
//  - Conceder acesso = o CONVIDADO se auto-inclui (só ele conhece o próprio
//    uid), e só se existir um convite válido para o e-mail dele.
//  - Revogar acesso = o DONO remove da lista.
//  - Ninguém consulta a lista de e-mails de ninguém: cada um só lê os convites
//    destinados ao próprio e-mail (e o dono, os convites da própria viagem).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email; }
    // Convites só valem para quem provou ser dono do e-mail (contas Google já
    // chegam verificadas; e-mail e senha exige confirmação pelo link).
    function emailVerificado() {
      return signedIn() && request.auth.token.email_verified == true;
    }
    function conviteDe(tripId) {
      return get(/databases/$(database)/documents/convites/$(tripId + '_' + myEmail())).data;
    }
    function tripData(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)).data;
    }
    function isMember(tripId) {
      return signedIn() && request.auth.uid in tripData(tripId).memberUids;
    }

    // Perfil do usuário — cada um só o seu (usado para exibir nomes; privado).
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Feedback in-app (T-1.2): qualquer usuário autenticado cria o PRÓPRIO
    // feedback. Ninguém lê, edita ou apaga pelo cliente — a leitura acontece
    // pelo Console/Admin SDK. Isso evita que o app vire um mural público e
    // impede que alguém leia o que outra pessoa relatou.
    match /feedback/{docId} {
      allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // Viagens
    match /trips/{tripId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids;

      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      allow update: if signedIn() && (
        // A) membro editando conteúdo, sem mexer na lista de membros nem no dono
        ( request.auth.uid in resource.data.memberUids
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.memberUids == resource.data.memberUids )
        ||
        // B) dono gerenciando a lista de membros (revogar acesso)
        ( resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId )
        ||
        // C) convidado se auto-incluindo — adiciona SÓ a si mesmo, e só se houver
        //    convite PENDENTE, criado pelo dono desta viagem, para o e-mail
        //    VERIFICADO dele. Convite aceito/recusado não vale (revogação efetiva).
        ( !(request.auth.uid in resource.data.memberUids)
          && request.auth.uid in request.resource.data.memberUids
          && request.resource.data.memberUids.removeAll(resource.data.memberUids) == [request.auth.uid]
          && resource.data.memberUids.removeAll(request.resource.data.memberUids).size() == 0
          && request.resource.data.ownerId == resource.data.ownerId
          && emailVerificado()
          && conviteDe(tripId).status == 'pendente'
          && conviteDe(tripId).ownerUid == resource.data.ownerId )
      );

      // Versões — membros leem, criam e atualizam; só o dono apaga
      match /versions/{versionId} {
        allow read, create, update: if isMember(tripId);
        allow delete: if signedIn() && tripData(tripId).ownerId == request.auth.uid;
      }

      // Presença — membros leem; cada um escreve só o próprio doc
      match /presence/{uid} {
        allow read: if isMember(tripId);
        allow write: if signedIn() && request.auth.uid == uid && isMember(tripId);
      }

      // Info de exibição de membros (nome/e-mail/papel)
      match /members/{uid} {
        allow read: if isMember(tripId);
        // só o dono da viagem grava `role: 'owner'`
        allow create, update: if signedIn() && request.auth.uid == uid && isMember(tripId)
          && (request.resource.data.get('role', '') != 'owner'
              || tripData(tripId).ownerId == request.auth.uid);
        // o próprio membro apaga o seu registro; o dono apaga qualquer um
        allow delete: if signedIn()
          && (request.auth.uid == uid || tripData(tripId).ownerId == request.auth.uid);
      }

      // Comentários por item (Fase 5, item 5.F) — herdam o acesso da viagem;
      // só o autor apaga o próprio comentário.
      match /comments/{commentId} {
        allow read: if isMember(tripId);
        allow create: if isMember(tripId) && request.resource.data.authorUid == request.auth.uid;
        allow delete: if signedIn() && resource.data.authorUid == request.auth.uid;
      }

      // Feed de atividade (Fase 5, item 5.F) — só leitura/criação; não se edita
      // nem se apaga um evento de atividade (é um log).
      match /activity/{eventId} {
        allow read: if isMember(tripId);
        allow create: if isMember(tripId) && request.resource.data.authorUid == request.auth.uid;
      }
    }

    // Convites — id `tripId_emailConvidado`; só o DONO da viagem cria.
    match /convites/{conviteId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && tripData(request.resource.data.tripId).ownerId == request.auth.uid
        && conviteId == request.resource.data.tripId + '_' + request.resource.data.emailConvidado
        && request.resource.data.status == 'pendente';
      // convidado (e-mail verificado) lê os seus; dono lê os que criou
      allow read: if signedIn() && (
        (emailVerificado() && resource.data.emailConvidado == myEmail())
        || resource.data.ownerUid == request.auth.uid
      );
      allow update: if signedIn() && (
        // convidado: só status (pendente -> aceito/recusado) e carimbo de aceite
        ( emailVerificado() && resource.data.emailConvidado == myEmail()
          && resource.data.status == 'pendente'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'acceptedByUid', 'acceptedAt'])
          && request.resource.data.status in ['aceito', 'recusado'] )
        ||
        // dono: reenviar o convite (setDoc sobre o mesmo id) mantendo viagem,
        // e-mail e autoria, sempre como pendente
        ( resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.tripId == resource.data.tripId
          && request.resource.data.emailConvidado == resource.data.emailConvidado
          && request.resource.data.status == 'pendente' )
      );
      // dono cancela o que criou; convidado verificado apaga o seu
      allow delete: if signedIn() && (
        (emailVerificado() && resource.data.emailConvidado == myEmail())
        || resource.data.ownerUid == request.auth.uid
      );
    }

    // Tudo o mais é negado.
    match /{document=**} { allow read, write: if false; }
  }
}
